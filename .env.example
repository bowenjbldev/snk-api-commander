# Dominio principal (vhost agnostico: web + /api). setup-ssl.sh genera su cert.
APP_DOMAIN=localhost

# Puertos publicados en el host por nginx y MariaDB
HTTP_PORT=8080
HTTPS_PORT=8443
DB_PORT=3307

# Dominio privado del control plane y dominio publico de los tenants.
# Evita .local: colisiona con mDNS y resuelve mal en Windows/WSL.
BASE_DOMAIN=snakepc.test
TENANT_BASE_DOMAIN=kilkana.test

# Activado por scripts/subscription.sh cuando existe docker-compose.clients.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.clients.yml

# UID/GID del usuario del host (mapeo www-data en la imagen PHP)
WWWUSER=1000
WWWGROUP=1000

# La app HTTP solo accede a commander; el worker provisioner recibe root por separado.
COMMANDER_DB_USERNAME=commander_app
COMMANDER_DB_PASSWORD=commander-local-secret
PROVISIONER_DB_PASSWORD=
CORE_ADMIN_EMAIL=admin@snake.com
CORE_ADMIN_PASSWORD=secret1234
KILKANA_DEMO_READER_PASSWORD=password

# MariaDB local corre con root SIN password (MARIADB_ALLOW_EMPTY_ROOT_PASSWORD).
# Cada suscripcion crea su BD/usuario/password = nombre del paquete en snake_case.
