APP_DOMAIN=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
DB_PORT=3307

# Dominio base para suscripciones locales (<cliente>.<BASE_DOMAIN>)
# Evita .local: colisiona con mDNS y resuelve mal en Windows/WSL
BASE_DOMAIN=snake.test

# Activado por subscription.sh cuando existe docker-compose.clients.yml
# COMPOSE_FILE=docker-compose.yml:docker-compose.clients.yml

WWWUSER=1000
WWWGROUP=1000

# Database (used by docker-compose for MariaDB)
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=root
DB_ROOT_PASSWORD=root
