APP_NAME=SnakeLaravelApi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Vacio = centralizado: UNA app sirve TODOS los packages, resueltos por subdominio
# ({package}.BASE_DOMAIN). Si se fija (ej. Shop) bloquea el deploy a ese unico package.
BASE_DOMAIN=snake.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# La instancia principal (agnostica) usa sqlite: arranca sin MariaDB.
# Multi-tenant (una BD por package). default=commander; el subdominio conmuta a 'tenant'.
# La app HTTP solo accede a commander. El worker provisioner recibe las credenciales DDL aparte.
DB_CONNECTION=commander
DB_HOST=db
DB_PORT=3306
DB_USERNAME=commander_app
DB_PASSWORD=commander-local-secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=900
KILKANA_SEED_DEMO=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CORS: origenes permitidos para llamadas directas del SPA al API (coma-separado). En dev: proxy Vite.
CORS_ALLOWED_ORIGINS=http://localhost:5174

# Tokens Bearer emitidos por login (24 horas por defecto).
CORE_TOKEN_EXPIRATION_MINUTES=1440
