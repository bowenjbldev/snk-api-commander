APP_NAME=SnakeLaravelApi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Una app sirve todos los packages: Commander usa BASE_DOMAIN y los tenants
# {cliente}.TENANT_BASE_DOMAIN. Sin TENANT_BASE_DOMAIN se reutiliza BASE_DOMAIN.
BASE_DOMAIN=snakepc.test
TENANT_BASE_DOMAIN=kilkana.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Passwords nuevos: Argon2id memory-hard. Recalibrar en el hardware de producción.
HASH_DRIVER=argon2id
HASH_VERIFY=true
ARGON_MEMORY=19456
ARGON_TIME=2
ARGON_THREADS=1

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# La instancia principal (agnostica) usa sqlite: arranca sin MariaDB.
# Multi-tenant (una BD por package). default=commander; el subdominio conmuta a 'tenant'.
# La app HTTP solo accede a commander. El worker provisioner recibe las credenciales DDL aparte.
DB_CONNECTION=commander
DB_HOST=db
DB_PORT=3306
DB_USERNAME=commander_app
DB_PASSWORD=commander-local-secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=900
KILKANA_SEED_DEMO=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# CORS: orígenes externos autorizados para llamar a la API, separados por comas.
CORS_ALLOWED_ORIGINS=

# Tokens Bearer emitidos por login (24 horas por defecto) y rate limits por minuto.
CORE_TOKEN_EXPIRATION_MINUTES=1440
CORE_API_RATE_LIMIT=240
# Solo cuentan credenciales incorrectas: por cuenta frena botnets y por IP credential stuffing.
CORE_LOGIN_ACCOUNT_RATE_LIMIT=5
CORE_LOGIN_IP_RATE_LIMIT=10
