# Los mismos hosts, certificado y limites que app.conf, con otro runtime detras: 8444 php-fpm
# (perfil `fpm`) y 8445 Octane sobre Swoole (perfil `swoole`). Puertos distintos para que
# convivan con `app` y `scripts/octane-ab.sh` los mida por el mismo TLS y el mismo nginx. Los dos
# upstreams se resuelven por variable, como commander.conf hace con commander-web, para que nginx
# arranque aunque los perfiles esten apagados: un nombre literal se resuelve al arrancar y tumba
# nginx si el contenedor no existe.
server {
    listen 8444 ssl;
    server_name ${APP_DOMAIN} *.${BASE_DOMAIN} *.${TENANT_BASE_DOMAIN} localhost;
    index index.php index.html;
    root /var/www/src/public;

    ssl_certificate     /etc/nginx/certs/wildcard.${BASE_DOMAIN}.pem;
    ssl_certificate_key /etc/nginx/certs/wildcard.${BASE_DOMAIN}-key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:TENANT_TLS:10m;
    ssl_session_timeout 1h;

    server_tokens off;
    reset_timedout_connection on;
    client_max_body_size 64m;
    add_header X-Content-Type-Options nosniff always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 4;
    gzip_types application/json application/problem+json application/xml application/javascript image/svg+xml text/plain text/css;

    resolver 127.0.0.11 valid=10s;
    set $fpm api-fpm:9000;

    # Único entrypoint PHP; solo se alcanza por el fallback interno de Laravel.
    location = /index.php {
        internal;
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass $fpm;
        fastcgi_connect_timeout 5s;
        fastcgi_send_timeout 60s;
        fastcgi_read_timeout 65s;
        fastcgi_buffer_size 16k;
        fastcgi_buffers 16 16k;
        fastcgi_busy_buffers_size 32k;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param HTTP_HOST $host;
        fastcgi_param HTTP_X_FORWARDED_FOR $remote_addr;
        fastcgi_param HTTP_X_FORWARDED_PROTO $scheme;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
    }

    location ~* \.php(?:$|[/.]) {
        return 404;
    }

    location ~ ^/storage/media/[^/]+/v/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri /index.php?$query_string;
    }

    location /storage/ {
        add_header Cache-Control "public, max-age=86400";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
        gzip_static on;
    }
}

server {
    listen 8445 ssl;
    server_name ${APP_DOMAIN} *.${BASE_DOMAIN} *.${TENANT_BASE_DOMAIN} localhost;
    root /var/www/src/public;

    ssl_certificate     /etc/nginx/certs/wildcard.${BASE_DOMAIN}.pem;
    ssl_certificate_key /etc/nginx/certs/wildcard.${BASE_DOMAIN}-key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:TENANT_TLS:10m;
    ssl_session_timeout 1h;

    server_tokens off;
    reset_timedout_connection on;
    client_max_body_size 64m;
    add_header X-Content-Type-Options nosniff always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 4;
    gzip_types application/json application/problem+json application/xml application/javascript image/svg+xml text/plain text/css;

    resolver 127.0.0.11 valid=10s;
    set $swoole http://api-swoole:8000;

    location ~* \.php(?:$|[/.]) {
        return 404;
    }

    location ~ ^/storage/media/[^/]+/v/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri @swoole;
    }

    location /storage/ {
        add_header Cache-Control "public, max-age=86400";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    location / {
        try_files $uri @swoole;
        gzip_static on;
    }

    location @swoole {
        proxy_pass $swoole;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 65s;
        proxy_buffer_size 16k;
        proxy_buffers 16 16k;
        proxy_busy_buffers_size 32k;
    }
}
