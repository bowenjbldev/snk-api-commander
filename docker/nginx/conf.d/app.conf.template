# Centralizado: UN solo vhost sirve el dominio privado, los tenants
# (*.${TENANT_BASE_DOMAIN}) y el dominio principal (${APP_DOMAIN}). El package se resuelve
# por host y path dentro de Laravel (CoreResolveInstanceFromHostMiddleware), no por vhost.
# El host exacto commander.${BASE_DOMAIN} lo gana commander.conf (server_name exacto
# tiene prioridad sobre el wildcard). default_server: hosts no provisionados caen aqui
# y Laravel responde 404.
server {
    listen 80 default_server;
    server_name ${APP_DOMAIN} *.${BASE_DOMAIN} *.${TENANT_BASE_DOMAIN} localhost;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name ${APP_DOMAIN} *.${BASE_DOMAIN} *.${TENANT_BASE_DOMAIN} localhost;
    index index.php index.html;
    error_log  /var/log/nginx/error.log;
    access_log /var/log/nginx/access.log;
    root /var/www/src/public;

    # setup-ssl.sh genera este certificado con ambos wildcards como SAN.
    ssl_certificate     /etc/nginx/certs/wildcard.${BASE_DOMAIN}.pem;
    ssl_certificate_key /etc/nginx/certs/wildcard.${BASE_DOMAIN}-key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:TENANT_TLS:10m;
    ssl_session_timeout 1h;

    server_tokens off;
    reset_timedout_connection on;
    client_max_body_size 64m;
    add_header X-Content-Type-Options nosniff always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 4;
    gzip_types application/json application/problem+json application/xml application/javascript image/svg+xml text/plain text/css;

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass api-app:9000;
        fastcgi_connect_timeout 5s;
        fastcgi_send_timeout 60s;
        fastcgi_read_timeout 65s;
        fastcgi_buffer_size 16k;
        fastcgi_buffers 16 16k;
        fastcgi_busy_buffers_size 32k;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param HTTP_HOST $host;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
        gzip_static on;
    }
}
