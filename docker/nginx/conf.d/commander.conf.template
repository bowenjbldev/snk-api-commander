# Commander mantiene un único origen: `/api/*` llega a Laravel y `/` queda reservado para el
# servicio opcional `commander-web`. El certificado de scripts/setup-ssl.sh cubre este subdominio.
server {
    listen 80;
    server_name commander.${BASE_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name commander.${BASE_DOMAIN};
    error_log  /var/log/nginx/error.log;
    access_log /var/log/nginx/access.log;
    root /var/www/src/public;

    ssl_certificate     /etc/nginx/certs/wildcard.${BASE_DOMAIN}.pem;
    ssl_certificate_key /etc/nginx/certs/wildcard.${BASE_DOMAIN}-key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:COMMANDER_TLS:2m;
    ssl_session_timeout 1h;

    server_tokens off;
    reset_timedout_connection on;
    client_max_body_size 64m;
    add_header X-Content-Type-Options nosniff always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 4;
    gzip_types application/json application/problem+json application/xml application/javascript image/svg+xml text/plain text/css;

    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 2s;

    # La API Commander siempre está disponible aunque el perfil `spa` esté apagado. Detrás está el
    # mismo Octane que sirve a los inquilinos: es el Host quien elige el plano de control.
    location ^~ /api/ {
        proxy_pass http://api-app:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Las cabeceras de confianza las escribe nginx y pisan las del cliente, como en app.conf:
        # los frenos por IP del plano de control cuelgan de ellas.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 65s;
        proxy_buffer_size 16k;
        proxy_buffers 16 16k;
        proxy_busy_buffers_size 32k;
    }

    # El nombre se resuelve en cada petición para que nginx arranque sin `commander-web`.
    location / {
        set $commander_web http://commander-web:5173;
        proxy_pass $commander_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_intercept_errors on;
        error_page 502 503 504 = @commander_web_missing;
    }

    location @commander_web_missing {
        return 404;
    }
}
