# Commander mantiene un único origen: `/api/*` llega a Laravel y `/` queda reservado para el
# servicio opcional `commander-web`. El certificado de scripts/setup-ssl.sh cubre este subdominio.
server {
    listen 80;
    server_name commander.${BASE_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name commander.${BASE_DOMAIN};
    error_log  /var/log/nginx/error.log;
    access_log /var/log/nginx/access.log;
    root /var/www/src/public;

    ssl_certificate     /etc/nginx/certs/wildcard.${BASE_DOMAIN}.pem;
    ssl_certificate_key /etc/nginx/certs/wildcard.${BASE_DOMAIN}-key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 2s;

    # La API Commander siempre está disponible aunque el perfil `spa` esté apagado.
    location ^~ /api/ {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass api-app:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param HTTP_HOST $host;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
    }

    # El nombre se resuelve en cada petición para que nginx arranque sin `commander-web`.
    location / {
        set $commander_web http://commander-web:5173;
        proxy_pass $commander_web;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_intercept_errors on;
        error_page 502 503 504 = @commander_web_missing;
    }

    location @commander_web_missing {
        return 404;
    }
}
